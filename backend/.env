# ─────────────────────────────────────────────────────────────────────────────
# Server Monitor – environment variable reference
# Copy to .env and adjust; never commit secrets to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Storage / PVC ─────────────────────────────────────────────────────────────
# Path where servers.json will be stored.
# In OpenShift, set this to the mount path of your PVC (e.g. /mnt/data).
DATA_DIR=./data

# ── SSH ───────────────────────────────────────────────────────────────────────
# Set SSH_MOCK_MODE=false to connect to real servers.
SSH_MOCK_MODE=true

SSH_USERNAME=root
SSH_PASSWORD=
SSH_KEY_PATH=          # absolute path to a PEM private key file
SSH_PORT=22
SSH_TIMEOUT=10         # seconds per command

# ── Polling ───────────────────────────────────────────────────────────────────
POLL_INTERVAL_SECONDS=300   # how often all servers are polled (seconds)
POLL_MAX_WORKERS=10         # max concurrent SSH threads

# ── API server ────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR
